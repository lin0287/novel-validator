{
  "name": "novel-validator",
  "version": "0.1.0",
  "private": true,
  "description": "Scene-based novel writing app with a continuity checker",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -p tsconfig.build.json && node dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "~5.9",
    "vitest": "^3.2.7"
  }
}
